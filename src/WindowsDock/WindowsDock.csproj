<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>WindowsDock.DockEntryPoint</StartupObject>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../Shared/DockIcon.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WindowsDock.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../Shared/AgentFaces.txt" LogicalName="WindowsDock.AgentFaces.txt" />
    <Resource Include="../Shared/DockIcon.ico" Link="DockIcon.ico" />
    <PackageReference Include="Ical.Net" Version="5.2.4" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.4.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Tomlyn" Version="0.19.0" />
  </ItemGroup>

</Project>
